{
    "name": "koriym/query-locator",
    "description":"Load and manage SQL queries from files",
    "keywords":[
        "SQL"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "phpunit/phpunit": "^11.5",
        "ray/di": "^2.16"
    },
    "autoload":{
        "psr-4":{
            "Koriym\\QueryLocator\\": "src/"
        }
    },
    "autoload-dev":{
        "psr-4":{
            "Koriym\\QueryLocator\\": ["tests/"],
            "MyVendor\\MyPacakge\\": [ "tests/Fake/"]
        }
    },
    "suggest": {
        "ext-apcu": "*"
    },
    "scripts" :{
        "bin": "echo 'bamarni/composer-bin-plugin is not installed: vendor-bin tools skipped.'",
        "post-install-cmd": ["@composer bin all install --ansi --ignore-platform-req=php"],
        "post-update-cmd": ["@composer bin all update --ansi --ignore-platform-req=php"],
        "test": ["phpunit"],
        "tests": ["@cs", "@sa", "@test"],
        "coverage": ["php -dzend_extension=xdebug.so -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage"],
        "cs": ["phpcs"],
        "cs-fix": ["phpcbf"],
        "sa": ["psalm --show-info=false", "phpstan analyse -c phpstan.neon --no-progress", "phpmd analyze src --format text --ruleset ./phpmd.xml"]
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false
        }
    }
}
